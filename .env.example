# Copy is created for you by setup_database.py / start.bat / start.sh.
# Fill these in only if you are configuring the database by hand.

JWT_SECRET_KEY=paste-your-generated-secret-here
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-postgres-password
PGDATABASE=erp_ai

# Optional. Needed only for the in-app AI assistant.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
