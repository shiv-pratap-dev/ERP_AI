# Copy is created for you by setup_database.py / start.bat / start.sh.
# Fill these in only if you are configuring the database by hand.

JWT_SECRET_KEY=paste-your-generated-secret-here
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-postgres-password
PGDATABASE=erp_ai

# LLM Provider: "gemini" (default) or "lmstudio" / "openai" (OpenAI-compatible)
LLM_PROVIDER=gemini
# For LM Studio / local OpenAI-compatible servers (used when LLM_PROVIDER=lmstudio or openai):
# LLM_BASE_URL=http://localhost:1235/v1
# LLM_MODEL=local-model
# LLM_API_KEY=lm-studio

# Optional. Needed only for the in-app AI assistant when LLM_PROVIDER=gemini.
# Create a key at https://aistudio.google.com/apikey
# Prefer a fast Flash model so free-form chat stays near 2–4 seconds.
# Current Google AI Studio ids include gemini-3.5-flash / gemini-3.8-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Chatbot terminal activity log (printed in the uvicorn/start terminal).
# 1=on (default), 0=off
CHAT_ACTIVITY_LOG=1
# Ask Gemini to expose thinking tokens when supported (slower). 0=off
CHAT_LOG_THOUGHTS=0
